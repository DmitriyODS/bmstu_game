SECRET_KEY=change-me-to-random-secret
DATABASE_URL=postgresql://quiz:quiz@db:5432/quiz
POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz
ADMIN_PASSWORD=admin
MAX_CONTENT_LENGTH=52428800
# Публичный адрес для QR-кода (если отличается от адреса, по которому открыта админка)
# PUBLIC_BASE_URL=https://quiz.example.ru
# 1 — приложение стоит за nginx/прокси, доверять заголовкам X-Forwarded-*
# TRUST_PROXY=1

# ── Хранилище файлов квизов ────────────────────────────────────────────────
# Общий лимит на все картинки и звуки, байт (по умолчанию 5 ГБ)
# STORAGE_LIMIT_BYTES=5368709120
# Папка для файлов, если S3 не подключён (по умолчанию app/static/uploads)
# STORAGE_DIR=/app/app/static/uploads
# S3: достаточно задать S3_BUCKET — файлы будут храниться в бакете.
# Перенос уже загруженных файлов: flask --app wsgi storage-push-s3
# S3_BUCKET=bmstu-quiz
# S3_ENDPOINT_URL=https://s3.example.ru
# S3_REGION=ru-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=quiz
# Необязательно: публичный адрес бакета. Тогда файлы отдаются напрямую из S3
# (нужны публичное чтение и CORS), иначе — через приложение.
# S3_PUBLIC_URL=https://cdn.example.ru
